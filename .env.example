# Copy to .env and fill in the values you were sent separately. Never commit .env.
# Values must be plain [A-Za-z0-9] strings.

# Database password shared by GLPI and MariaDB inside the compose network.
GLPI_DB_PASSWORD=

# Legacy REST API: the App-Token of the API client named "assignment-pack".
GLPI_APP_TOKEN=

# Legacy REST API: user tokens of the two API accounts, one per role.
#   onboarding.bot   profile "Onboarding admin",      granted at Root, recursive
#   inventory.bot    profile "Inventory technician",  granted at Root > Acme > India > Engineering, recursive
GLPI_API_TOKEN_ONBOARDING=
GLPI_API_TOKEN_INVENTORY=

# UI sign-in for your own eyes (the UI is the ground truth). Not read by compose.
GLPI_UI_ADMIN_LOGIN=glpi
GLPI_UI_ADMIN_PASSWORD=

# Port the proxy publishes on your machine.
PROXY_PORT=8080
